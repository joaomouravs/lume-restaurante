---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Marquee from '@/components/sections/Marquee.astro';
import About from '@/components/sections/About.astro';
import Signatures from '@/components/sections/Signatures.astro';
import Chef from '@/components/sections/Chef.astro';
import MenuPreview from '@/components/sections/MenuPreview.astro';
import Journey from '@/components/sections/Journey.astro';
import Experiences from '@/components/sections/Experiences.astro';
import Gallery from '@/components/sections/Gallery.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Visit from '@/components/sections/Visit.astro';
import ReserveBand from '@/components/sections/ReserveBand.astro';
---

<BaseLayout headerVariant="split">
  <Hero />
  <Marquee />
  <About />
  <Signatures />
  <Chef />
  <MenuPreview />
  <Journey />
  <Experiences />
  <Gallery />
  <Testimonials />
  <Visit />
  <ReserveBand />
</BaseLayout>
