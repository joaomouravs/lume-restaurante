---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/ui/Media.astro';
import Icon from '@/components/ui/Icon.astro';

import heroPlate from '@/assets/images/hero-plate.png';
---

<BaseLayout title="Página não encontrada" noindex>
  <section class="not-found theme-dark texture-ink" aria-labelledby="nf-title">
    <div class="container not-found__inner">
      <div class="not-found__plate" aria-hidden="true">
        <span class="not-found__digit">4</span>
        <div class="not-found__img">
          <Media src={heroPlate} alt="" sizes="(min-width: 768px) 22vw, 36vw" widths={[320, 480]} priority />
        </div>
        <span class="not-found__digit">4</span>
      </div>
      <p class="eyebrow eyebrow--center">Erro 404</p>
      <h1 id="nf-title" class="heading h-l">Este prato saiu do cardápio</h1>
      <p class="lead">A página que você procura não existe mais ou mudou de lugar. Que tal voltar para a mesa?</p>
      <div class="not-found__actions">
        <a href="/" class="btn btn--light">
          Ir para o início
          <span class="btn__icon"><Icon name="arrow-right" size={16} /></span>
        </a>
        <a href="/cardapio" class="link">Ver cardápio <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: calc(var(--header-h) + var(--space-xl)) 0 var(--space-2xl);
    color: var(--paper-100);
    text-align: center;
  }

  .not-found__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
  }

  .not-found__plate {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    margin-bottom: var(--space-l);
  }

  .not-found__digit {
    font-family: var(--font-display);
    font-size: clamp(7rem, 4rem + 14vw, 16rem);
    line-height: 0.8;
    color: var(--brass-300);
  }

  .not-found__img {
    width: clamp(120px, 20vw, 260px);
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: var(--shadow-plate);
    animation: nf-spin 30s linear infinite;
  }

  .not-found__img :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  @keyframes nf-spin {
    to { transform: rotate(360deg); }
  }

  .not-found .lead {
    margin-inline: auto;
    color: var(--color-fg-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-m) var(--space-l);
    margin-top: var(--space-m);
  }
</style>
