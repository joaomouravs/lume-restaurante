---
/**
 * Imagem otimizada padrão do projeto.
 * Gera AVIF + WebP com srcset responsivo a partir de assets locais.
 * `sizes` deve sempre refletir a largura real ocupada no layout.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  pictureClass?: string;
  quality?: number;
  position?: string;
}

const {
  src,
  alt,
  sizes,
  widths = [480, 768, 1080, 1440, 1920],
  priority = false,
  class: className,
  pictureClass,
  quality = 72,
  position,
} = Astro.props;

// Nunca gerar variações maiores que o arquivo original
const safeWidths = widths.filter((w) => w <= src.width);
if (safeWidths.length === 0) safeWidths.push(src.width);

const isPng = src.format === 'png';
---

<Picture
  src={src}
  alt={alt}
  widths={safeWidths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat={isPng ? 'png' : 'jpg'}
  quality={quality}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={className}
  style={position ? `object-position: ${position}` : undefined}
  pictureAttributes={{ class: pictureClass }}
/>
