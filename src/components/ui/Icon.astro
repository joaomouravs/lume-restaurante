---
/**
 * Biblioteca de ícones inline (traço 1.5px, grade 24×24).
 * Inline evita requisições extras e herda `currentColor`.
 */
const icons = {
  'arrow-right': '<path d="M4 12h16M14 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  'arrow-up': '<path d="M12 20V4M6 10l6-6 6 6"/>',
  'arrow-down': '<path d="M12 4v16M6 14l6 6 6-6"/>',
  'chevron-left': '<path d="m15 5-7 7 7 7"/>',
  'chevron-right': '<path d="m9 5 7 7-7 7"/>',
  'chevron-down': '<path d="m5 9 7 7 7-7"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  menu: '<path d="M3 8h18M3 16h18"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 1 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  phone:
    '<path d="M5 4.5h3.2l1.6 4-2 1.3a10.5 10.5 0 0 0 6.4 6.4l1.3-2 4 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 6.1 1.5 1.5 0 0 1 5 4.5Z"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4 7 8 6 8-6"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="1.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  users:
    '<circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19.5c.6-3 2.8-4.8 5.5-4.8s4.9 1.8 5.5 4.8"/><path d="M15.5 5.6a3.2 3.2 0 0 1 0 6M17.2 14.9c1.8.6 3 2.2 3.3 4.6"/>',
  star: '<path d="m12 3.8 2.5 5.2 5.7.8-4.1 4 1 5.6-5.1-2.7-5.1 2.7 1-5.6-4.1-4 5.7-.8L12 3.8Z"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  flame:
    '<path d="M12 21c-3.9 0-6.5-2.6-6.5-6.2 0-4.3 4.4-6.3 4.4-10.3 2.8 1.6 4 3.7 4 6 1-.6 1.7-1.7 1.9-3 1.7 1.7 2.7 4.2 2.7 7.1 0 3.8-2.6 6.4-6.5 6.4Z"/><path d="M12 21c-1.6 0-2.8-1.1-2.8-2.8 0-2 2-2.8 2.8-4.7.9 1.9 2.8 2.7 2.8 4.7 0 1.7-1.2 2.8-2.8 2.8Z"/>',
  leaf: '<path d="M5 19C5 10 10.5 5 19.5 4.5 19 13.5 14 19 5 19Z"/><path d="M5 19c3-3.5 6-6 9.5-8.5"/>',
  wine: '<path d="M8 3.5h8l-.5 5a3.5 3.5 0 0 1-7 0L8 3.5ZM12 12v8.5M8.5 20.5h7"/>',
  car: '<path d="M4.5 16.5v-4l2-5h11l2 5v4M4.5 16.5h15M4.5 16.5V19M19.5 16.5V19"/><circle cx="8" cy="13.8" r=".8"/><circle cx="16" cy="13.8" r=".8"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/>',
  spotify:
    '<circle cx="12" cy="12" r="8.5"/><path d="M7.5 9.6c3-1 6.4-.7 9 .8M8 12.6c2.5-.7 5.1-.5 7.3.7M8.6 15.3c1.9-.5 3.8-.3 5.4.6"/>',
  tripadvisor:
    '<circle cx="7.5" cy="13" r="3.5"/><circle cx="16.5" cy="13" r="3.5"/><path d="M4 9.5c2.2-1.6 5-2.5 8-2.5s5.8.9 8 2.5M12 7l-1.2 2M12 7l1.2 2"/><circle cx="7.5" cy="13" r=".7" fill="currentColor"/><circle cx="16.5" cy="13" r=".7" fill="currentColor"/>',
  whatsapp:
    '<path d="M4 20l1.2-4A8.5 8.5 0 1 1 8 19Z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8a4.3 4.3 0 0 1-2.3-2.3l.8-1-1-2L9.5 8Z"/>',
  expand: '<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number | string;
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, label, class: className, strokeWidth = 1.5 } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icons[name]}
/>
