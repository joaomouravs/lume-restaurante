---
/**
 * Assinatura visual: um círculo (o prato, a lua, a boca do forno)
 * guardando uma chama — a luz que dá nome à casa.
 */
interface Props {
  class?: string;
  showTagline?: boolean;
}

const { class: className, showTagline = true } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="1.1"></circle>
    <path
      d="M20 30.5c-3.6 0-6-2.4-6-5.7 0-3.9 4-5.8 4-9.4 2.6 1.4 3.7 3.4 3.7 5.5.9-.5 1.6-1.5 1.8-2.7 1.5 1.5 2.5 3.8 2.5 6.4 0 3.5-2.4 5.9-6 5.9Z"
      fill="currentColor"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Lume</span>
    {showTagline && <span class="logo__tagline">Cozinha de fogo</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
  }

  .logo__mark {
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    color: var(--logo-mark, var(--brass-500));
    transition: transform var(--dur-slow) var(--ease-out);
  }

  :global(a:hover) > .logo .logo__mark,
  :global(a:focus-visible) > .logo .logo__mark {
    transform: rotate(-12deg);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-right: -0.28em;
  }

  .logo__tagline {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
