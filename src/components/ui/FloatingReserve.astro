---
/**
 * Botão "Reservar mesa" fixo no rodapé da tela (apenas celular).
 * Aparece quando o header se esconde e some perto de outras chamadas de reserva.
 */
import Icon from '@/components/ui/Icon.astro';
---

<a href="/reservas" class="float-cta" data-float-cta>
  <span class="float-cta__text">
    <span class="float-cta__title">Reservar mesa</span>
    <span class="float-cta__meta" data-status-text-float>Jantar de terça a sábado</span>
  </span>
  <span class="float-cta__icon" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
</a>

<style>
  .float-cta {
    display: none;
  }

  @media (max-width: 767px) {
    .float-cta {
      position: fixed;
      left: var(--gutter);
      right: var(--gutter);
      bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem);
      z-index: calc(var(--z-header) - 2);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 3.5rem;
      padding: 0.5rem 0.5rem 0.5rem 1.25rem;
      border: 1px solid rgb(243 238 230 / 0.12);
      border-radius: var(--radius-pill);
      background: color-mix(in srgb, var(--ink-900) 94%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      color: var(--paper-100);
      box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.55);
      visibility: hidden;
      opacity: 0;
      transform: translateY(calc(100% + 1rem));
      transition:
        transform var(--dur-base) var(--ease-out),
        opacity var(--dur-base) var(--ease-out),
        visibility 0s linear var(--dur-base);
    }

    .float-cta.is-visible {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
  }

  .float-cta__text {
    display: grid;
    line-height: 1.2;
  }

  .float-cta__title {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .float-cta__meta {
    font-size: 0.75rem;
    color: var(--stone-400);
  }

  .float-cta__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--brass-400);
    color: var(--ink-950);
  }

  .float-cta:active .float-cta__icon {
    transform: scale(0.94);
  }
</style>

<script>
  import { getOpenStatus } from '@/scripts/open-status';
  import { schedule } from '@/data/site';

  const cta = document.querySelector<HTMLElement>('[data-float-cta]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (cta && header) {
    // Texto de apoio com o status atual (ex.: "Aberto agora · jantar até 23h30")
    const meta = cta.querySelector<HTMLElement>('[data-status-text-float]');
    if (meta) meta.textContent = getOpenStatus(schedule).text;

    let nearOtherCta = false;

    const update = () => {
      const show = header.classList.contains('is-hidden') && !nearOtherCta && !document.body.classList.contains('is-locked');
      cta.classList.toggle('is-visible', show);
    };

    new MutationObserver(update).observe(header, { attributes: true, attributeFilter: ['class'] });
    new MutationObserver(update).observe(document.body, { attributes: true, attributeFilter: ['class'] });

    // Some sobre seções marcadas com [data-no-float-cta]: já têm chamada de reserva
    // própria ou controles na base da tela que o botão cobriria
    const others = document.querySelectorAll('[data-no-float-cta]');
    const visibleOthers = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visibleOthers.add(e.target) : visibleOthers.delete(e.target)));
      nearOtherCta = visibleOthers.size > 0;
      update();
    });
    others.forEach((el) => io.observe(el));
  }
</script>
