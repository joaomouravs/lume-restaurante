---
/**
 * Linha de cardápio: nome ···· preço, descrição e selos alimentares.
 * Reutilizada na prévia da home e na página de cardápio.
 */
import { getImage } from 'astro:assets';
import Media from '@/components/ui/Media.astro';
import Icon from '@/components/ui/Icon.astro';
import { dietLabels, formatPrice, type MenuItem } from '@/data/menu';

interface Props {
  item: MenuItem;
  headingLevel?: 'h3' | 'h4';
}

const { item, headingLevel: Heading = 'h3' } = Astro.props;

// Miniatura para a foto que acompanha o cursor (carregada só no hover)
const isCutout = item.image?.format === 'png';
const thumb = item.image
  ? await getImage({ src: item.image, width: 540, format: 'webp', quality: 72 })
  : undefined;
---

<article
  class="menu-row"
  data-tags={(item.tags ?? []).join(' ')}
  data-cursor-src={thumb?.src}
  data-cursor-cutout={isCutout ? '' : undefined}
>
  <div class:list={['menu-row__thumb', { 'is-cutout': isCutout, 'is-empty': !item.image }]} aria-hidden="true">
    {item.image ? <Media src={item.image} alt="" sizes="64px" widths={[128]} quality={70} /> : <Icon name="flame" size={20} />}
  </div>
  <div class="menu-row__body">
  <div class="menu-row__top">
    <Heading class="menu-row__name">
      {item.name}
      {item.signature && <span class="menu-row__badge" title="Prato assinatura">Assinatura</span>}
    </Heading>
    <span class="menu-row__leader" aria-hidden="true"></span>
    <p class="menu-row__price"><span class="visually-hidden">Preço: </span>R$ {formatPrice(item.price)}</p>
  </div>
  <p class="menu-row__desc">{item.description}</p>
  {
    ((item.tags && item.tags.length > 0) || item.signature) && (
      <ul class="menu-row__tags" role="list" aria-label="Informações do prato">
        {item.signature && <li class="menu-row__tag-sig" aria-hidden="true">Assinatura</li>}
        {item.tags?.map((t) => (
          <li>{dietLabels[t].label}</li>
        ))}
      </ul>
    )
  }
  </div>
</article>

<style>
  .menu-row {
    display: grid;
    gap: 1rem;
    padding-block: 1.25rem;
  }

  .menu-row__body {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  /* Miniatura do prato: só em telas de toque (no desktop a foto segue o cursor) */
  .menu-row__thumb {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    .menu-row:has(.menu-row__thumb) {
      grid-template-columns: 4rem minmax(0, 1fr);
      align-items: start;
    }

    .menu-row__thumb {
      display: block;
      width: 4rem;
      aspect-ratio: 1;
      margin-top: 0.2rem;
      overflow: hidden;
      border-radius: 50%;
      background: var(--ink-800);
      box-shadow: 0 10px 20px -12px rgb(20 14 8 / 0.5);
    }

    .menu-row__thumb.is-cutout {
      background: transparent;
    }

    /* Prato sem foto: círculo discreto com a chama da marca, mantendo o alinhamento */
    .menu-row__thumb.is-empty {
      display: grid;
      place-items: center;
      background: color-mix(in srgb, var(--color-fg) 6%, transparent);
      box-shadow: none;
      color: var(--color-accent);
    }

    .menu-row__thumb :global(picture),
    .menu-row__thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .menu-row__top {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .menu-row__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.15;
    text-wrap: balance;
  }

  .menu-row__badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    vertical-align: 0.35em;
    color: var(--color-accent);
  }

  .menu-row__leader {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--color-fg) 35%, transparent);
    transform: translateY(-0.3em);
  }

  .menu-row__price {
    flex: none;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    font-variant-numeric: lining-nums;
  }

  .menu-row__desc {
    max-width: 52ch;
    font-size: var(--step--1);
    color: var(--color-fg-muted);
  }

  .menu-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.35rem 0 0;
  }

  /* No celular o selo sai do título (evita quebras) e vira etiqueta */
  .menu-row__tag-sig {
    display: none;
  }

  @media (max-width: 639px) {
    /* Oculto só visualmente: leitores de tela continuam anunciando "Assinatura" */
    .menu-row__badge {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    .menu-row__tags .menu-row__tag-sig {
      display: block;
      border: 1px solid currentColor;
      background: transparent;
      color: var(--color-accent);
    }
  }

  .menu-row__tags li {
    padding: 0.18rem 0.6rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-fg) 7%, transparent);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }
</style>
