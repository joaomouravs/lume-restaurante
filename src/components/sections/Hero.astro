---
import Media from '@/components/ui/Media.astro';
import Icon from '@/components/ui/Icon.astro';
import { schedule, site } from '@/data/site';

import firePoster from '@/assets/images/hero-fire-poster.jpg';
import heroPlate from '@/assets/images/hero-plate.png';

const scheduleJson = JSON.stringify(schedule.map(({ day, short, shifts }) => ({ day, short, shifts })));
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__text texture-paper">
    <div class="hero__fade" data-hero-fade>
      <p class="hero__intro">
        Cozinha contemporânea brasileira, conduzida pela brasa e pelas estações. Desde {site.foundingYear}, nos
        Jardins.
      </p>
    </div>

    <div class="hero__fade hero__bottom" data-hero-fade>
      <h1 id="hero-title" class="hero__title display display--caps">
        <span class="split-line" style="--i: 1"><span>A arte</span></span>
        <span class="split-line" style="--i: 2"><span>do <em>fogo</em>,</span></span>
        <span class="split-line" style="--i: 3"><span>à mesa</span></span>
      </h1>

      <div class="hero__actions">
        <a href="/reservas" class="btn">
          Reservar mesa
          <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
        </a>
        <a href="/cardapio" class="link">Ver cardápio <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </div>

  <div class="hero__media theme-dark" data-hero-media>
    <div class="hero__image">
      <Media
        src={firePoster}
        alt="Brasa de carvão com chamas baixas no braseiro da cozinha"
        sizes="(min-width: 1024px) 100vw, 100vw"
        widths={[640, 960, 1280]}
        priority
        quality={70}
        position="35% 50%"
      />
      <video
        class="hero__video"
        muted
        playsinline
        loop
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        data-hero-video
        data-src-desktop="/video/brasa-1280.mp4"
        data-src-mobile="/video/brasa-720.mp4"></video>
    </div>

    <p class="hero__caption" data-hero-caption aria-hidden="true">
      <span class="caps">Lenha de laranjeira</span>
      <span class="hero__caption-line"></span>
      <span class="caps">A brasa acende às 11h</span>
    </p>

    <div class="hero__controls">
      <button type="button" class="hero__toggle" data-video-toggle aria-pressed="false" hidden>
        <span class="hero__toggle-icon" aria-hidden="true"></span>
        <span class="visually-hidden" data-video-label>Pausar vídeo</span>
      </button>
      <div class="hero__status" data-status data-schedule={scheduleJson}>
        <span class="hero__status-dot" aria-hidden="true"></span>
        <span data-status-text>Jantar de terça a sábado · 19h</span>
      </div>
    </div>
  </div>

  <div class="hero__plate" aria-hidden="true" data-hero-plate>
    <div class="hero__plate-spin">
      <Media
        src={heroPlate}
        alt=""
        sizes="(min-width: 1024px) 34vw, 58vw"
        widths={[360, 540, 720, 960]}
        priority
        quality={80}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    --split: 48%;
    --radius: clamp(120px, 16vw, 300px);
    --plate: clamp(280px, min(30vw, 54vh), 540px);
    position: relative;
    display: grid;
    grid-template-columns: var(--split) 1fr;
    height: max(680px, 100svh);
    max-height: 1100px;
    background: var(--paper-100);
    isolation: isolate;
    overflow: hidden;
  }

  /* ---------- Texto ---------- */
  .hero__text {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: calc(var(--header-h) + clamp(1.5rem, 4vw, 4rem)) var(--gutter) clamp(2.5rem, 5vw, 4.5rem);
  }

  .hero__bottom {
    display: grid;
    gap: var(--space-xl);
  }

  .hero__intro {
    max-width: 30ch;
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--color-fg-muted);
  }

  .hero__title {
    position: relative;
    z-index: 4;
    font-size: clamp(3.4rem, 1.2rem + 7.2vw, 9.25rem);
    line-height: 0.88;
  }

  .hero__title em {
    color: var(--brass-600);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m) var(--space-l);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity var(--dur-slow) var(--ease-out) 700ms,
      transform var(--dur-slow) var(--ease-out) 700ms;
  }

  .hero.is-visible .hero__actions,
  :global(.no-js) .hero__actions {
    opacity: 1;
    transform: none;
  }

  /* ---------- Mídia (vídeo da brasa) ----------
     No desktop a mídia cobre todo o hero e é recortada por clip-path;
     a rolagem abre o recorte até a tela cheia. */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--ink-950);
    clip-path: inset(0% 0% 0% var(--split) round 0px 0px 0px var(--radius));
  }

  .hero__image {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 100%);
    transition: clip-path 1600ms var(--ease-in-out) 100ms;
  }

  .hero.is-visible .hero__image,
  :global(.no-js) .hero__image {
    clip-path: inset(0 0 0 0);
  }

  .hero__image :global(picture),
  .hero__image :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__image :global(img),
  .hero__video {
    transform: scale(1.12);
    transition: transform 2600ms var(--ease-out);
  }

  .hero.is-visible .hero__image :global(img),
  .hero.is-visible .hero__video {
    transform: scale(1.02);
  }

  .hero__video {
    object-position: 35% 50%;
    opacity: 0;
    transition:
      opacity 1200ms var(--ease-out),
      transform 2600ms var(--ease-out);
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  .hero__image::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(11 10 9 / 0.6) 0%, transparent 30%),
      linear-gradient(0deg, rgb(11 10 9 / 0.65) 0%, transparent 42%);
  }

  /* Legenda que surge quando o vídeo ocupa a tela */
  .hero__caption {
    position: absolute;
    left: 50%;
    bottom: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    align-items: center;
    gap: 1rem;
    translate: -50% 0;
    color: rgb(243 238 230 / 0.85);
    white-space: nowrap;
    opacity: 0;
  }

  .hero__caption-line {
    width: 3rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .hero__controls {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__status,
  .hero__toggle {
    border: 1px solid rgb(243 238 230 / 0.18);
    background: rgb(11 10 9 / 0.35);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--paper-100);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius-pill);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .hero__status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--stone-400);
  }

  .hero__status[data-open='true'] .hero__status-dot {
    background: #7fc48a;
  }

  .hero__status[data-open='true'] .hero__status-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid #7fc48a;
    animation: pulse 2.2s var(--ease-out) infinite;
  }

  @keyframes pulse {
    from { transform: scale(0.6); opacity: 1; }
    to { transform: scale(1.8); opacity: 0; }
  }

  /* Botão pausar/reproduzir */
  .hero__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    transition: background var(--dur-base) var(--ease-out);
  }

  .hero__toggle:hover {
    background: rgb(243 238 230 / 0.2);
  }

  .hero__toggle-icon {
    position: relative;
    width: 10px;
    height: 12px;
    border-inline: 3px solid currentColor;
  }

  .hero__toggle[aria-pressed='true'] .hero__toggle-icon {
    border: 0;
    width: 0;
    height: 0;
    margin-left: 3px;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid currentColor;
  }

  /* ---------- Prato flutuante ---------- */
  .hero__plate {
    position: absolute;
    z-index: 3;
    top: calc(var(--header-h) + clamp(0.5rem, 3vh, 2.5rem));
    left: calc(var(--split) - var(--plate) * 0.38);
    width: var(--plate);
    aspect-ratio: 1;
    pointer-events: none;
  }

  .hero__plate-spin {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    box-shadow: var(--shadow-plate);
    opacity: 0;
    transform: rotate(-70deg) scale(0.82);
    transition:
      opacity 1200ms var(--ease-out) 500ms,
      transform 2000ms var(--ease-out) 500ms;
  }

  .hero.is-visible .hero__plate-spin,
  :global(.no-js) .hero__plate-spin {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .hero__plate :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  /* Sem GSAP (movimento reduzido ou navegador antigo): giro leve via CSS */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(html:not(.has-motion)) .hero__plate {
        animation: plate-scroll linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes plate-scroll {
    to { transform: rotate(40deg) translateY(8%); }
  }

  /* ---------- Tablet e mobile ---------- */
  @media (max-width: 1023px) {
    .hero {
      --plate: clamp(210px, 52vw, 400px);
      --media-h: clamp(420px, 64svh, 720px);
      grid-template-columns: 1fr;
      grid-template-rows: var(--media-h) auto;
      height: auto;
      max-height: none;
    }

    .hero__media {
      position: relative;
      grid-row: 1;
      grid-column: 1;
      clip-path: none;
      border-radius: 0 0 50% 50% / 0 0 var(--curve) var(--curve);
      overflow: hidden;
    }

    .hero__text {
      grid-row: 2;
      padding-top: calc(var(--plate) * 0.5 + var(--space-l));
      gap: var(--space-l);
    }

    /* Ordem no mobile: título → texto → botões */
    .hero__bottom {
      display: contents;
    }

    .hero__fade:not(.hero__bottom) {
      order: 2;
    }

    .hero__intro {
      max-width: 42ch;
    }

    .hero__title {
      order: 1;
      font-size: clamp(3.3rem, 1rem + 11vw, 7rem);
    }

    .hero__actions {
      order: 3;
    }

    .hero__plate {
      top: calc(var(--media-h) - var(--plate) * 0.62);
      left: auto;
      right: var(--gutter);
    }

    .hero__caption {
      display: none;
    }

    .hero__controls {
      top: calc(var(--header-h) + 0.5rem);
      left: var(--gutter);
      right: auto;
      bottom: auto;
      flex-direction: row-reverse;
      justify-content: flex-end;
    }
  }

  @media (max-width: 479px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .link {
      align-self: flex-start;
    }
  }
</style>

<script>
  import { initOpenStatus } from '@/scripts/open-status';
  import { initHero } from '@/scripts/hero';

  // O hero entra imediatamente, sem esperar o IntersectionObserver
  requestAnimationFrame(() => document.querySelector('.hero')?.classList.add('is-visible'));
  initOpenStatus();
  initHero();
</script>
