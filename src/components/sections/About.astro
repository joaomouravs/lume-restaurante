---
import Media from '@/components/ui/Media.astro';
import Icon from '@/components/ui/Icon.astro';
import { stats } from '@/data/content';
import { site } from '@/data/site';

import brasaGrill from '@/assets/images/brasa-grill.jpg';
import tableWine from '@/assets/images/table-wine.jpg';
---

<section id="a-casa" class="about section texture-ink theme-dark curve-bottom" aria-labelledby="about-title">
  <div class="container">
    <header class="about__header">
      <p class="eyebrow eyebrow--center" data-reveal>A Casa</p>
      <h2 id="about-title" class="about__statement heading" data-split>
        Uma cozinha guiada pelo <em>fogo</em>, pelas estações e pelo respeito a quem planta o que servimos.
      </h2>
    </header>

    <div class="about__body">
      <figure class="about__img about__img--small media-frame" data-reveal="clip">
        <Media
          src={tableWine}
          alt="Garrafa de vinho e taças em mesa posta sob luz quente"
          sizes="(min-width: 1024px) 20vw, 42vw"
          widths={[360, 540, 720]}
        />
      </figure>

      <figure class="about__img about__img--tall media-frame" data-reveal="clip" style="--i: 1">
        <Media
          src={brasaGrill}
          alt="Costela assando sobre a grelha, com a brasa viva por baixo"
          sizes="(min-width: 1024px) 30vw, 50vw"
          widths={[480, 720, 960, 1200]}
        />
        <figcaption class="about__caption caps">Lenha de laranjeira · 12h de brasa</figcaption>
      </figure>

      <div class="about__text">
        <p class="about__since heading" data-reveal>Desde {site.foundingYear}</p>
        <p class="body-muted" data-reveal style="--i: 1">
          O Lume nasceu de uma ideia simples: cozinhar como se cozinha em casa no interior do Brasil, com lenha, tempo
          e ingredientes que têm nome e sobrenome. Trabalhamos com 38 pequenos produtores e mudamos o menu a cada
          estação.
        </p>
        <p class="body-muted" data-reveal style="--i: 2">
          O resultado é uma cozinha precisa e generosa, servida em um salão intimista onde a luz é baixa e o tempo
          corre devagar.
        </p>
        <a href="#chef" class="btn btn--light" data-reveal style="--i: 3">
          Conheça o chef
          <span class="btn__icon"><Icon name="arrow-down" size={16} /></span>
        </a>
      </div>
    </div>

    <ul class="about__stats" role="list">
      {
        stats.map((stat, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <p class="about__stat-value">
              <span data-count={stat.value}>{stat.value}</span>
              {stat.suffix}
            </p>
            <p class="about__stat-label">{stat.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    position: relative;
    z-index: 1;
    padding-bottom: calc(var(--section-y) + var(--curve) * 0.6);
  }

  .about__header {
    display: grid;
    justify-items: center;
    gap: var(--space-l);
    text-align: center;
    max-width: 58rem;
    margin-inline: auto;
  }

  .about__statement {
    font-size: var(--step-5);
    line-height: 1.08;
  }

  .about__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    gap: var(--space-l);
    margin-top: clamp(3.5rem, 8vw, 7rem);
  }

  .about__img {
    margin: 0;
    border-radius: var(--radius-s);
  }

  .about__img--small {
    grid-column: 1 / span 3;
    aspect-ratio: 4 / 5;
    align-self: start;
  }

  .about__img--tall {
    grid-column: 4 / span 4;
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px var(--radius-s) var(--radius-s);
  }

  .about__caption {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgb(11 10 9 / 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--paper-100);
    white-space: nowrap;
  }

  .about__text {
    grid-column: 9 / span 4;
    display: grid;
    justify-items: start;
    gap: var(--space-m);
    padding-bottom: var(--space-s);
  }

  .about__since {
    font-size: var(--step-3);
    font-style: italic;
    color: var(--brass-400);
  }

  .about__text .btn {
    margin-top: var(--space-s);
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(4rem, 8vw, 7rem) 0 0;
    border-top: 1px solid var(--color-line);
  }

  .about__stats li {
    padding: var(--space-l) var(--space-m) 0 0;
  }

  .about__stats li + li {
    padding-left: var(--space-m);
    border-left: 1px solid var(--color-line);
  }

  .about__stat-value {
    font-family: var(--font-display);
    font-size: var(--step-6);
    line-height: 1;
    color: var(--paper-100);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .about__stat-label {
    margin-top: var(--space-xs);
    max-width: 18ch;
    font-size: var(--step--1);
    color: var(--color-fg-muted);
  }

  @media (max-width: 1023px) {
    .about__body {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .about__img--small {
      grid-column: 1 / span 3;
      margin-top: var(--space-2xl);
    }

    .about__img--tall {
      grid-column: 4 / span 3;
    }

    .about__text {
      grid-column: 1 / -1;
      max-width: 38rem;
      margin-top: var(--space-l);
    }

    .about__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about__stats li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .about__stats li:nth-child(n + 3) {
      margin-top: var(--space-l);
      border-top: 1px solid var(--color-line);
    }
  }

  @media (max-width: 559px) {
    .about__caption {
      display: none;
    }

    .about__stats li {
      padding-right: var(--space-s);
    }

    .about__stats li + li {
      padding-left: var(--space-s);
    }

    .about__stats li:nth-child(3) {
      padding-left: 0;
    }
  }
</style>
