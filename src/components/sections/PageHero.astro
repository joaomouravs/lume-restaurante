---
/**
 * Cabeçalho das páginas internas: imagem escura, título grande e trilha de navegação.
 */
import type { ImageMetadata } from 'astro';
import Media from '@/components/ui/Media.astro';

interface Props {
  eyebrow: string;
  image: ImageMetadata;
  /** Enquadramento vertical próprio para o celular (assunto no alto, texto embaixo) */
  imageMobile?: ImageMetadata;
  imagePosition?: string;
  breadcrumb: string;
  compact?: boolean;
}

const { eyebrow, image, imageMobile, imagePosition = 'center', breadcrumb, compact = false } = Astro.props;
---

<section class:list={["page-hero theme-dark curve-bottom", { "page-hero--compact": compact }]} aria-labelledby="page-title" data-reveal-group>
  <div class="page-hero__bg" aria-hidden="true">
    <Media
      src={image}
      mobileSrc={imageMobile}
      alt=""
      sizes="100vw"
      widths={[768, 1280, 1920]}
      priority
      position={imagePosition}
    />
  </div>

  <div class="container page-hero__inner">
    <nav class="page-hero__crumbs caps" aria-label="Você está em">
      <ol role="list">
        <li><a href="/">Início</a></li>
        <li aria-current="page">{breadcrumb}</li>
      </ol>
    </nav>

    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title" class="page-hero__title display">
      <slot />
    </h1>
    {
      Astro.slots.has('intro') && (
        <div class="page-hero__intro lead">
          <slot name="intro" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: end;
    min-height: clamp(520px, 78svh, 820px);
    padding: calc(var(--header-h) + var(--space-2xl)) 0 calc(var(--space-2xl) + var(--curve) * 0.6);
    color: var(--paper-100);
    background: var(--ink-950);
    overflow: hidden;
    isolation: isolate;
  }

  .page-hero--compact {
    min-height: clamp(420px, 58svh, 620px);
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .page-hero__bg :global(picture),
  .page-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__bg :global(img) {
    transform: scale(1.1);
    transition: transform 2400ms var(--ease-out);
  }

  .page-hero.is-visible .page-hero__bg :global(img) {
    transform: scale(1);
  }

  .page-hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(11 10 9 / 0.7) 0%, rgb(11 10 9 / 0.35) 40%, rgb(11 10 9 / 0.85) 100%);
  }

  .page-hero__inner {
    display: grid;
    gap: var(--space-m);
  }

  .page-hero__crumbs ol {
    display: flex;
    gap: 0.6rem;
    margin: 0 0 var(--space-l);
    color: rgb(243 238 230 / 0.7);
  }

  .page-hero__crumbs li + li::before {
    content: '/';
    margin-right: 0.6rem;
    opacity: 0.5;
  }

  .page-hero__crumbs a:hover {
    color: var(--paper-100);
  }

  .page-hero__crumbs a {
    display: inline-block;
    padding-block: 0.9rem;
    margin-block: -0.9rem;
  }

  .page-hero__crumbs [aria-current] {
    color: var(--brass-300);
  }

  .page-hero__title {
    font-size: var(--step-7);
    line-height: 0.92;
  }

  .page-hero__intro {
    margin-top: var(--space-s);
    color: rgb(243 238 230 / 0.78);
  }

  /* Desktop: o título fica à esquerda e as fotos têm o assunto à direita —
     véu lateral para o texto não disputar com os pratos/mesa */
  @media (min-width: 640px) {
    .page-hero__bg::after {
      background:
        linear-gradient(90deg, rgb(11 10 9 / 0.62) 0%, rgb(11 10 9 / 0.35) 38%, rgb(11 10 9 / 0) 62%),
        linear-gradient(180deg, rgb(11 10 9 / 0.7) 0%, rgb(11 10 9 / 0.35) 40%, rgb(11 10 9 / 0.85) 100%);
    }
  }

  /* No celular o texto cobre quase toda a foto: véu mais denso para leitura */
  @media (max-width: 639px) {
    .page-hero__bg::after {
      background:
        linear-gradient(180deg, rgb(11 10 9 / 0.78) 0%, rgb(11 10 9 / 0.55) 45%, rgb(11 10 9 / 0.9) 100%);
    }
  }

  /* Entrada */
  .page-hero__inner > * {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .page-hero__inner > :nth-child(2) { transition-delay: 100ms; }
  .page-hero__inner > :nth-child(3) { transition-delay: 200ms; }
  .page-hero__inner > :nth-child(4) { transition-delay: 320ms; }

  .page-hero.is-visible .page-hero__inner > *,
  :global(.no-js) .page-hero__inner > * {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  requestAnimationFrame(() => document.querySelector('.page-hero')?.classList.add('is-visible'));
</script>
