---
import Icon from '@/components/ui/Icon.astro';
import map from '@/data/brazil-map.json';
import { MAP, project, distanceKm } from '@/data/map-projection';
import { producers, kitchen } from '@/data/producers';

const fmtKm = (km: number) => `${new Intl.NumberFormat('pt-BR').format(km)} km`;

const [kx, ky] = project(kitchen.lng, kitchen.lat);

const points = producers.map((p, i) => {
  const [x, y] = project(p.lng, p.lat);
  // Rota em arco até a cozinha: curva para "cima" do trajeto, proporcional à distância
  const mx = (x + kx) / 2;
  const my = (y + ky) / 2;
  const dx = kx - x;
  const dy = ky - y;
  const len = Math.hypot(dx, dy) || 1;
  let nx = -dy / len;
  let ny = dx / len;
  if (ny > 0) {
    nx = -nx;
    ny = -ny;
  }
  const bend = Math.min(160, len * 0.28);
  const cx = mx + nx * bend;
  const cy = my + ny * bend;
  return {
    ...p,
    index: i,
    x,
    y,
    route: `M${x.toFixed(1)} ${y.toFixed(1)} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${kx.toFixed(1)} ${ky.toFixed(1)}`,
    distance: fmtKm(distanceKm(p, kitchen)),
  };
});

// Malha de latitude/longitude a cada 10° (estética de atlas)
const graticule = [
  ...[0, -10, -20, -30].map((lat) => {
    const [x1, y] = project(-74, lat);
    const [x2] = project(-34.6, lat);
    return { d: `M${x1} ${y}H${x2}`, label: `${Math.abs(lat)}°${lat < 0 ? 'S' : ''}`, lx: x2 - 4, ly: y - 8, anchor: 'end' };
  }),
  ...[-70, -60, -50, -40].map((lng) => {
    const [x, y1] = project(lng, 5.4);
    const [, y2] = project(lng, -33.9);
    return { d: `M${x} ${y1}V${y2}`, label: `${Math.abs(lng)}°O`, lx: x + 8, ly: y2 - 10, anchor: 'start' };
  }),
];

const first = points[0];
const payload = JSON.stringify(
  points.map(({ id, name, city, state, region, ingredient, dish, since, note, distance }) => ({
    id,
    name,
    place: `${city} · ${state}`,
    region,
    ingredient,
    dish,
    since,
    note,
    distance,
  })),
);
const total = String(points.length).padStart(2, '0');
---

<section
  id="produtores"
  class="producers section texture-paper curve-top overlap-up"
  aria-labelledby="producers-title"
  data-producers
  data-payload={payload}
>
  <div class="container producers__grid">
    <div class="producers__info">
      <p class="eyebrow" data-reveal>Produtores</p>
      <h2 id="producers-title" class="heading h-l" data-split>
        Quem planta o <em>que</em> servimos
      </h2>
      <p class="lead" data-reveal>
        São 38 pequenos produtores em 12 estados. Escolha um para conhecer a origem de cada ingrediente e o caminho
        que ele percorre até a nossa cozinha.
      </p>

      <article class="producer-card" data-reveal aria-live="polite" aria-atomic="true" data-card>
        <p class="producer-card__count caps">
          <span data-f="index">01</span> / {total} · <span data-f="region">{first.region}</span>
        </p>
        <h3 class="producer-card__ingredient heading" data-f="ingredient">{first.ingredient}</h3>
        <p class="producer-card__name" data-f="name">{first.name}</p>
        <p class="producer-card__place caps">
          <Icon name="pin" size={14} />
          <span data-f="place">{first.city} · {first.state}</span>
        </p>
        <p class="producer-card__note" data-f="note">{first.note}</p>
        <dl class="producer-card__facts">
          <div>
            <dt class="caps">No cardápio</dt>
            <dd data-f="dish">{first.dish}</dd>
          </div>
          <div>
            <dt class="caps">Até a cozinha</dt>
            <dd data-f="distance">{first.distance}</dd>
          </div>
          <div>
            <dt class="caps">Parceria desde</dt>
            <dd data-f="since">{first.since}</dd>
          </div>
        </dl>
        <div class="producer-card__nav">
          <button type="button" class="carousel-btn" data-step="-1" aria-label="Produtor anterior">
            <Icon name="chevron-left" size={20} />
          </button>
          <button type="button" class="carousel-btn" data-step="1" aria-label="Próximo produtor">
            <Icon name="chevron-right" size={20} />
          </button>
        </div>
      </article>
    </div>

    <div class="producers__side">
    <figure class="producers__map" data-map>
      <svg viewBox={map.viewBox} role="img" aria-labelledby="map-title map-desc">
        <title id="map-title">Mapa do Brasil com os produtores parceiros do Lume</title>
        <desc id="map-desc">
          {points.length} produtores marcados de norte a sul do país, todos ligados por rotas à cozinha em São Paulo.
        </desc>
        <defs>
          <pattern id="map-dots" width="9" height="9" patternUnits="userSpaceOnUse">
            <circle cx="4.5" cy="4.5" r="1.1" fill="currentColor"></circle>
          </pattern>
        </defs>

        <g class="map-graticule" aria-hidden="true">
          {
            graticule.map((g) => (
              <>
                <path d={g.d} />
                <text x={g.lx} y={g.ly} text-anchor={g.anchor}>
                  {g.label}
                </text>
              </>
            ))
          }
        </g>

        <path class="map-land" d={map.outline}></path>
        <path class="map-dots" d={map.outline}></path>
        <g class="map-states" aria-hidden="true">
          {map.states.map((s) => <path d={s.d} />)}
        </g>
        <path class="map-outline" d={map.outline} pathLength="1"></path>

        <g class="map-routes" aria-hidden="true">
          {
            points.map((p, i) => (
              <path class:list={['map-route', { 'is-active': i === 0 }]} d={p.route} pathLength="1" data-route={p.id} />
            ))
          }
        </g>

        <g class="map-points" aria-hidden="true">
          {
            points.map((p, i) => (
              <g
                class:list={['map-point', { 'is-active': i === 0 }]}
                transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}
                data-point={p.id}
                style={`--i: ${i}`}
              >
                <circle class="map-point__hit" r="18" />
                <circle class="map-point__ring" r="14" />
                <circle class="map-point__dot" r="6" />
              </g>
            ))
          }
        </g>

        <g class="map-kitchen" transform={`translate(${kx.toFixed(1)} ${ky.toFixed(1)})`} aria-hidden="true">
          <circle r="17" class="map-kitchen__disc"></circle>
          <path
            class="map-kitchen__flame"
            transform="translate(-10.5 -12) scale(0.9)"
            d="M12 26.5c-4.3 0-7.2-2.9-7.2-6.8 0-4.7 4.8-7 4.8-11.3 3.1 1.7 4.4 4.1 4.4 6.6 1.1-.6 1.9-1.8 2.2-3.2 1.8 1.8 3 4.6 3 7.7 0 4.2-2.9 7-7.2 7Z"
          ></path>
          <text class="map-kitchen__label" x="-26" y="-18" text-anchor="end">Lume</text>
          <text class="map-kitchen__sub" x="-26" y="4" text-anchor="end">São Paulo</text>
        </g>
      </svg>
      <figcaption class="producers__legend caps">
        <span><i class="legend-dot" aria-hidden="true"></i> Produtor parceiro</span>
        <span><i class="legend-kitchen" aria-hidden="true"></i> Nossa cozinha</span>
      </figcaption>
    </figure>

    <ul class="producers__list scroll-fade" role="list" aria-label="Escolha um produtor">
      {
        points.map((p, i) => (
          <li>
            <button type="button" class="producer-chip" aria-pressed={i === 0 ? 'true' : 'false'} data-select={p.id}>
              <span class="producer-chip__name">{p.name}</span>
              <span class="producer-chip__place">
                {p.city} · {p.state}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    </div>
  </div>
</section>

<style>
  .producers {
    z-index: 2;
    padding-top: calc(var(--section-y) + var(--curve) * 0.5);
  }

  .producers__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-xl) clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .producers__info {
    display: grid;
    gap: var(--space-m);
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  /* ---------- Cartão do produtor ---------- */
  .producer-card {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--space-m);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-l);
    background: var(--ink-900);
    color: var(--paper-100);
    box-shadow: var(--shadow-card);
  }

  .producer-card > * {
    transition:
      opacity 300ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .producer-card.is-changing > :not(.producer-card__nav) {
    opacity: 0;
    transform: translateY(8px);
  }

  .producer-card__count {
    color: var(--brass-400);
  }

  .producer-card__ingredient {
    font-size: var(--step-4);
    line-height: 1.05;
  }

  .producer-card__name {
    font-weight: 600;
  }

  .producer-card__place {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--stone-400);
  }

  .producer-card__note {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: #c9bfb0;
  }

  .producer-card__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
    margin: var(--space-s) 0 0;
    padding-top: var(--space-m);
    border-top: 1px solid rgb(243 238 230 / 0.14);
  }

  .producer-card__facts dt {
    color: var(--stone-400);
  }

  .producer-card__facts dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .producer-card__nav {
    display: flex;
    gap: 0.5rem;
    margin-top: var(--space-s);
  }

  .producer-card__nav .carousel-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(243 238 230 / 0.2);
    border-radius: 50%;
    color: var(--paper-100);
    transition: background var(--dur-base) var(--ease-out);
  }

  .producer-card__nav .carousel-btn:hover {
    background: rgb(243 238 230 / 0.12);
  }

  /* ---------- Mapa ---------- */
  .producers__map {
    margin: 0;
  }

  .producers__map svg {
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--ink-900);
  }

  .map-graticule path {
    fill: none;
    stroke: var(--stone-400);
    stroke-width: 0.8;
    stroke-dasharray: 2 6;
    opacity: 0.6;
  }

  .map-graticule text {
    font-family: var(--font-sans);
    font-size: 15px;
    letter-spacing: 0.08em;
    fill: var(--stone-500);
  }

  .map-land {
    fill: var(--paper-50);
  }

  .map-dots {
    fill: url(#map-dots);
    opacity: 0.1;
  }

  .map-states path {
    fill: none;
    stroke: var(--brass-500);
    stroke-width: 1;
    opacity: 0.45;
  }

  .map-outline {
    fill: none;
    stroke: var(--ink-900);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* Rotas: só a do produtor ativo aparece, desenhando-se até a cozinha */
  .map-route {
    fill: none;
    stroke: var(--brass-600);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .map-route.is-active {
    opacity: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1100ms var(--ease-in-out);
  }

  .map-point {
    cursor: pointer;
  }

  .map-point__hit {
    fill: transparent;
  }

  .map-point__dot {
    fill: var(--brass-500);
    stroke: var(--paper-50);
    stroke-width: 2.5;
    transition:
      fill var(--dur-base) var(--ease-out),
      r var(--dur-base) var(--ease-out);
  }

  .map-point__ring {
    fill: none;
    stroke: var(--brass-500);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .map-point:hover .map-point__dot {
    fill: var(--ink-900);
  }

  .map-point.is-active .map-point__dot {
    fill: var(--ink-900);
    r: 8;
  }

  .map-point.is-active .map-point__ring {
    opacity: 1;
    animation: map-pulse 2s var(--ease-out) infinite;
  }

  @keyframes map-pulse {
    from { transform: scale(0.6); opacity: 0.9; }
    to { transform: scale(1.9); opacity: 0; }
  }

  .map-kitchen__disc {
    fill: var(--ink-900);
    stroke: var(--brass-400);
    stroke-width: 2;
  }

  .map-kitchen__flame {
    fill: var(--brass-400);
  }

  .map-kitchen__label {
    font-family: var(--font-display);
    font-size: 30px;
    font-style: italic;
    fill: var(--ink-900);
  }

  .map-kitchen__sub {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--stone-500);
  }

  /* Entrada: o contorno se desenha e os pontos surgem em sequência */
  :global(.js) .producers__map:not(.is-drawn) .map-outline {
    stroke-dashoffset: 1;
  }

  :global(.js) .producers__map .map-outline {
    transition: stroke-dashoffset 2400ms var(--ease-in-out);
  }

  :global(.js) .producers__map:not(.is-drawn) .map-route,
  :global(.js) .producers__map:not(.is-drawn) .map-point,
  :global(.js) .producers__map:not(.is-drawn) .map-kitchen,
  :global(.js) .producers__map:not(.is-drawn) .map-states {
    opacity: 0;
  }

  :global(.js) .producers__map .map-point,
  :global(.js) .producers__map .map-kitchen,
  :global(.js) .producers__map .map-states {
    transition: opacity 600ms var(--ease-out);
    transition-delay: calc(900ms + var(--i, 0) * 60ms);
  }

  .producers__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin-top: var(--space-m);
    color: var(--color-fg-muted);
  }

  .producers__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend-dot,
  .legend-kitchen {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--brass-500);
  }

  .legend-kitchen {
    width: 12px;
    height: 12px;
    background: var(--ink-900);
    box-shadow: 0 0 0 2px var(--brass-400);
  }

  /* ---------- Lista de produtores ---------- */
  .producers__side {
    display: grid;
    gap: var(--space-l);
    min-width: 0;
  }

  .producers__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding-top: var(--space-l);
    border-top: 1px solid var(--color-line);
  }

  .producer-chip {
    display: grid;
    gap: 0.1rem;
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    text-align: left;
    transition:
      background var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .producer-chip:hover {
    border-color: var(--ink-900);
  }

  .producer-chip[aria-pressed='true'] {
    background: var(--ink-900);
    border-color: var(--ink-900);
    color: var(--paper-100);
  }

  .producer-chip__name {
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
  }

  .producer-chip__place {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
    white-space: nowrap;
  }

  .producer-chip[aria-pressed='true'] .producer-chip__place {
    color: var(--stone-400);
  }

  @media (prefers-reduced-motion: reduce) {
    .map-point.is-active .map-point__ring {
      animation: none;
      opacity: 0.6;
    }
  }

  @media (max-width: 1023px) {
    .producers__grid {
      grid-template-columns: 1fr;
    }

    .producers__info {
      position: static;
    }

    /* No celular: mapa e lista primeiro, cartão logo abaixo */
    .producers__side {
      order: -1;
    }

    .producers__info {
      display: contents;
    }

    .producers__info > .eyebrow,
    .producers__info > .heading,
    .producers__info > .lead {
      order: -2;
    }

    .producers__list {
      order: 1;
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: 0.25rem;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .producers__list::-webkit-scrollbar {
      display: none;
    }

    .producers__list li {
      scroll-snap-align: start;
    }

    .producer-card {
      order: 2;
      margin-top: 0;
    }
  }

  @media (max-width: 559px) {
    .producer-card__facts {
      grid-template-columns: 1fr 1fr;
    }

    .map-graticule text {
      display: none;
    }

    .map-kitchen__label {
      font-size: 40px;
    }

    .map-kitchen__sub {
      display: none;
    }
  }
</style>

<script>
  import { initProducers } from '@/scripts/producers';
  initProducers();
</script>
